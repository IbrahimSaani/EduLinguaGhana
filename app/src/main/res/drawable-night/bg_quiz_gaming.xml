<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#0D1117"
                android:centerColor="#1A237E"
                android:endColor="#311B92" />
        </shape>
    </item>
    <!-- Grid overlay for "tech/game" look -->
    <item>
        <shape>
            <stroke android:width="0.3dp" android:color="#449575CD" android:dashWidth="1dp" android:dashGap="20dp" />
        </shape>
    </item>
</layer-list>
