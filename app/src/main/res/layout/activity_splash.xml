<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="true">

    <!-- Top and Bottom Waves for Depth -->
    <ImageView
        android:id="@+id/topWave"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:alpha="0.3"
        android:scaleType="fitXY"
        android:src="@drawable/ic_wave_top"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/bottomWave"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:alpha="0.4"
        android:scaleType="fitXY"
        android:src="@drawable/ic_wave_bottom"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Premium Floating Decorative Elements -->
    <ImageView
        android:id="@+id/decorStar1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:alpha="0"
        android:src="@drawable/ic_decorative_star"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="60dp" />

    <ImageView
        android:id="@+id/decorCircle1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0"
        android:src="@drawable/ic_decorative_circle"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="180dp"
        android:layout_marginStart="40dp" />

    <ImageView
        android:id="@+id/decorDiamond1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:alpha="0"
        android:src="@drawable/ic_decorative_diamond"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="200dp"
        android:layout_marginStart="80dp" />

    <ImageView
        android:id="@+id/decorStar2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:alpha="0"
        android:src="@drawable/ic_decorative_star"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="250dp"
        android:layout_marginEnd="40dp" />

    <!-- Center Content Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/centerCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="40dp"
        app:cardElevation="24dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_splash_center_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:src="@drawable/ic_logo_professional"
                    android:contentDescription="@string/app_name"
                    android:elevation="8dp" />

                <!-- Logo Shine Overlay -->
                <View
                    android:id="@+id/logoShine"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:alpha="0"
                    android:background="@drawable/bg_splash_shine"
                    android:elevation="9dp"
                    android:rotation="45"
                    android:translationX="-140dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAppNameSplash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0"
                android:fontFamily="@font/agbalumo"
                android:text="EduLingua Ghana"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="6"
                android:shadowRadius="12" />

            <TextView
                android:id="@+id/tvTaglineSplash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/splash_tagline"
                android:textColor="#E3F2FD"
                android:textSize="16sp"
                android:letterSpacing="0.05" />

            <!-- Morph Dots Container -->
            <LinearLayout
                android:id="@+id/morphDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="visible">

                <View android:id="@+id/dot1" android:layout_width="10dp" android:layout_height="10dp" android:layout_margin="6dp" android:background="@drawable/dot_morph" android:alpha="0" />
                <View android:id="@+id/dot2" android:layout_width="10dp" android:layout_height="10dp" android:layout_margin="6dp" android:background="@drawable/dot_morph" android:alpha="0" />
                <View android:id="@+id/dot3" android:layout_width="10dp" android:layout_height="10dp" android:layout_margin="6dp" android:background="@drawable/dot_morph" android:alpha="0" />
                <View android:id="@+id/dot4" android:layout_width="10dp" android:layout_height="10dp" android:layout_margin="6dp" android:background="@drawable/dot_morph" android:alpha="0" />
                <View android:id="@+id/dot5" android:layout_width="10dp" android:layout_height="10dp" android:layout_margin="6dp" android:background="@drawable/dot_morph" android:alpha="0" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Progress Section -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/splash_progress_label"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProgressPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_splash_track" />

            <ImageView
                android:id="@+id/progressSparkle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:alpha="0"
                android:src="@drawable/ic_progress_sparkle"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
