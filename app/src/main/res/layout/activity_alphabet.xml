<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/appBackground"
    tools:context=".AlphabetActivity">

    <!-- Decorative background elements -->
    <ImageView
        android:id="@+id/decorativeShape1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="100dp"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:src="@drawable/shape_circle_pink" />

    <ImageView
        android:id="@+id/decorativeShape2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="30dp"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:src="@drawable/shape_star" />

    <ImageView
        android:id="@+id/decorativeShape3"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="150dp"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:src="@drawable/shape_circle_cyan" />

    <ImageView
        android:id="@+id/decorativeShape4"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_gravity="center|end"
        android:layout_marginEnd="25dp"
        android:alpha="0.3"
        android:contentDescription="@null"
        android:src="@drawable/shape_sparkle" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background"
        android:elevation="8dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:title="@string/alphabet_mode"
            app:titleTextAppearance="@style/ToolbarTitleStyle"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Progress Section with Counter and Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical"
                android:spacing="16dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Animated Progress Counter with Enhanced Design -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:spacing="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐"
                            android:textSize="28sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:spacing="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recital_progress_label"
                                android:textColor="@color/colorOnAccent"
                                android:textSize="12sp"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/tvProgressCounter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Letter 1 of 26"
                                android:textColor="@color/colorOnAccent"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/agbalumo" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📊"
                                android:textSize="24sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Enhanced SeekBar Section with better styling -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/ripple_card_effect"
                    android:elevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:spacing="8dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/colorAccent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recital_quick_nav_label"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:alpha="0.8" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBarNavigation"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:max="25"
                        android:progress="0"
                        android:progressBackgroundTint="@color/buttonSecondary"
                        android:progressTint="@color/colorAccent"
                        android:thumbTint="@color/colorPrimary"
                        android:scaleY="1.2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recital_nav_hint_alphabet"
                        android:textColor="@color/textColorSecondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:alpha="0.75" />
                </LinearLayout>

                <!-- Progress Bar with Enhanced Visual -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/progressIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_progress_sparkle"
                        app:tint="@color/colorAccent" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_toEndOf="@id/progressIcon"
                        android:progress="0"
                        app:indicatorColor="@color/colorAccent"
                        app:trackColor="@color/buttonSecondary"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp" />
                </RelativeLayout>

                <!-- Quick Access Grid and Picker Button with Enhanced Styling -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:spacing="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowGrid"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/recital_grid_button_alphabet"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:elevation="6dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconSize="20dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:spacing="12dp"
                android:layout_marginBottom="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/languageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/ripple_card_effect"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp"
                    app:strokeWidth="3dp"
                    app:strokeColor="@color/colorAccent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.08"
                        android:background="@drawable/bg_splash_gradient" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        android:gravity="center_vertical"
                        android:spacing="20dp">

                        <!-- Language emoji -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="8dp"
                            app:cardBackgroundColor="@color/colorAccent">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🌍"
                                android:textSize="32sp"
                                android:gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:spacing="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recital_language_label"
                                android:textColor="@color/textColorSecondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:alpha="0.7" />

                            <TextView
                                android:id="@+id/tvLanguageTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/language_prefix"
                                android:textColor="@color/colorPrimary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/agbalumo" />

                            <TextView
                                android:id="@+id/tvModeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/alphabet_mode"
                                android:textColor="@color/colorAccent"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Mode emoji -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="8dp"
                            app:cardBackgroundColor="@color/colorPrimary">

                            <TextView
                                android:id="@+id/modeIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="📖"
                                android:textSize="32sp"
                                android:gravity="center" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Main Content Area with Enhanced Visuals and Interactivity -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="@dimen/nav_button_size"
                    android:layout_height="@dimen/nav_button_size"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/content_description_previous"
                    android:padding="0dp"
                    app:cornerRadius="28dp"
                    app:elevation="8dp"
                    app:icon="@drawable/ic_back"
                    app:iconGravity="textStart"
                    app:iconSize="32dp"
                    app:iconPadding="0dp"
                    app:backgroundTint="@color/colorAccent"
                    app:iconTint="@color/white" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/letterCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/btnPrev"
                    android:layout_toStartOf="@id/btnNext"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="16dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="48dp"
                        android:paddingBottom="48dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp">

                        <TextView
                            android:id="@+id/celebrationEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textSize="48sp"
                            android:layout_marginBottom="24dp" />

                        <TextView
                            android:id="@+id/tvLetter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="40dp"
                            android:fontFamily="@font/agbalumo"
                            android:text="A"
                            android:textColor="@color/colorPrimary"
                            android:textSize="120sp"
                            android:textStyle="bold"
                            android:shadowColor="#20000000"
                            android:shadowDx="6"
                            android:shadowDy="6"
                            android:shadowRadius="12" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="4dp"
                            android:background="@color/colorAccent"
                            android:layout_marginBottom="32dp" />

                        <TextView
                            android:id="@+id/tvLetterWord"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/agbalumo"
                            android:gravity="center"
                            android:layout_marginBottom="12dp"
                            tools:text="Apple" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recital_tap_for_sound"
                            android:textColor="@color/textColorSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:alpha="0.6" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="@dimen/nav_button_size"
                    android:layout_height="@dimen/nav_button_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/content_description_next"
                    android:padding="0dp"
                    app:cornerRadius="28dp"
                    app:elevation="8dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textStart"
                    app:iconSize="32dp"
                    app:iconPadding="0dp"
                    app:backgroundTint="@color/colorAccent"
                    app:iconTint="@color/white" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/content_description_back"
        app:srcCompat="@drawable/ic_back_fab" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>