<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/appBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:background="@drawable/gradient_background"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leaderboard"
                    android:textAppearance="@style/ToolbarTitleStyle"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="28sp"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/white" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Login Required State -->
        <LinearLayout
            android:id="@+id/loginRequiredLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:cardCornerRadius="70dp"
                app:cardElevation="8dp"
                app:strokeWidth="4dp"
                app:strokeColor="@color/colorPrimary"
                app:cardBackgroundColor="#FFF3E0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🔒"
                    android:textSize="72sp"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="🏆 Login Required"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/agbalumo"
                android:textColor="@color/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sign in to compete on the leaderboard\nand see global rankings!"
                android:textSize="16sp"
                android:textColor="@color/textColorSecondary"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Sign In Now"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                app:icon="@android:drawable/ic_lock_idle_lock"
                app:iconSize="20dp"
                app:cornerRadius="28dp"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:cardCornerRadius="70dp"
                app:cardElevation="6dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/colorPrimary"
                app:cardBackgroundColor="@color/cardBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🏆"
                    android:textSize="72sp"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="No Rankings Yet"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/agbalumo"
                android:textColor="@color/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Complete quizzes and activities\nto join the competition!"
                android:textSize="16sp"
                android:textColor="@color/textColorSecondary"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartCompeting"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Start Competing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconSize="20dp"
                app:cornerRadius="28dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/colorPrimary" />

        </LinearLayout>

        <!-- Main Content -->
        <LinearLayout
            android:id="@+id/mainContentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Hero Section (Your Status) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_leaderboard_rank_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/avatar_size_medium"
                        android:layout_height="@dimen/avatar_size_medium"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/dividerColor">
                            <com.edulinguaghana.AvatarView
                                android:id="@+id/ivYourAvatarHero"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerInside" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvYourNameHero"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your Performance"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/agbalumo"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Keep climbing the ranks! 🚀"
                                android:textSize="12sp"
                                android:textColor="#E0E0E0"
                                android:alpha="0.9" />
                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/white"
                        android:alpha="0.2"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Rank -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏆 RANK"
                                android:textSize="11sp"
                                android:textColor="#BDBDBD"
                                android:letterSpacing="0.1"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvYourRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="#--"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:fontFamily="@font/agbalumo" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:background="@color/white"
                            android:alpha="0.2" />

                        <!-- Score -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐ SCORE"
                                android:textSize="11sp"
                                android:textColor="#BDBDBD"
                                android:letterSpacing="0.1"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvYourScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorAccent"
                                android:fontFamily="@font/agbalumo" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Podium Section -->
            <LinearLayout
                android:id="@+id/podiumSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <!-- 2nd Place -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥈"
                        android:textSize="24sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/leaderboard_podium_other"
                        android:layout_height="@dimen/leaderboard_podium_other"
                        android:layout_marginTop="4dp"
                        app:cardCornerRadius="35dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#C0C0C0">
                        <com.edulinguaghana.AvatarView
                            android:id="@+id/avatar2nd"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/name2nd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Player 2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/agbalumo"
                        android:textColor="@color/textColorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score2nd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 pts"
                        android:textSize="10sp"
                        android:textColor="@color/textColorSecondary" />
                </LinearLayout>

                <!-- 1st Place -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👑"
                        android:textSize="32sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/leaderboard_podium_1st"
                        android:layout_height="@dimen/leaderboard_podium_1st"
                        android:layout_marginTop="4dp"
                        app:cardCornerRadius="45dp"
                        app:cardElevation="8dp"
                        app:strokeWidth="4dp"
                        app:strokeColor="#FFD700">
                        <com.edulinguaghana.AvatarView
                            android:id="@+id/avatar1st"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/name1st"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Player 1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/agbalumo"
                        android:textColor="@color/colorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score1st"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 pts"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAccent" />
                </LinearLayout>

                <!-- 3rd Place -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥉"
                        android:textSize="24sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/leaderboard_podium_other"
                        android:layout_height="@dimen/leaderboard_podium_other"
                        android:layout_marginTop="4dp"
                        app:cardCornerRadius="35dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#CD7F32">
                        <com.edulinguaghana.AvatarView
                            android:id="@+id/avatar3rd"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/name3rd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Player 3"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/agbalumo"
                        android:textColor="@color/textColorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/score3rd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 pts"
                        android:textSize="10sp"
                        android:textColor="@color/textColorSecondary" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@color/dividerColor"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="Top Players"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textColorPrimary"
                android:fontFamily="@font/agbalumo" />

            <!-- Leaderboard List -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/leaderboardRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp"
                    android:clipToPadding="false" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- User Sticky Footer Rank -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/userRankStickyFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:cardCornerRadius="0dp"
            app:cardElevation="16dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/colorPrimary"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvFooterRank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#--"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/agbalumo" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">
                    <com.edulinguaghana.AvatarView
                        android:id="@+id/ivFooterAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvFooterName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="You"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/agbalumo" />

                <TextView
                    android:id="@+id/tvFooterScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pts"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:fontFamily="@font/agbalumo" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
