<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_premium"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/dynamicBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:titleTextAppearance="@style/ToolbarTitleStyle"
            app:titleTextColor="@color/white"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Avatar Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF"
            app:cardBackgroundColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customize Your Look"
                    android:textSize="@dimen/text_headline_small"
                    android:textStyle="bold"
                    android:fontFamily="@font/agbalumo"
                    android:textColor="@color/white"
                    android:shadowColor="#40000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:letterSpacing="0.02"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeMaxTextSize="18sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/hero_animation_size"
                    android:layout_height="@dimen/hero_animation_size"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="110dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="4dp"
                    app:strokeColor="@color/white"
                    app:cardBackgroundColor="@color/cardBackground">

                    <com.edulinguaghana.AvatarView
                        android:id="@+id/avatarPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangeBackground"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:text="BG Color"
                        app:icon="@drawable/ic_theme"
                        app:iconSize="18dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:iconTint="@color/white"
                        android:backgroundTint="#40FFFFFF"
                        app:cornerRadius="12dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRandomAvatar"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="Random"
                        app:icon="@drawable/ic_progress_sparkle"
                        app:iconSize="18dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:iconTint="@color/white"
                        android:backgroundTint="#40FFFFFF"
                        app:cornerRadius="12dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@color/cardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:minHeight="64dp"
                    app:tabPaddingStart="16dp"
                    app:tabPaddingEnd="16dp"
                    app:tabMinWidth="100dp"
                    app:tabMode="scrollable"
                    app:tabGravity="fill"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="4dp"
                    app:tabIndicatorColor="@color/colorAccent"
                    app:tabSelectedTextColor="@color/colorPrimary"
                    app:tabTextColor="@color/textColorSecondary"
                    app:tabRippleColor="@color/colorAccent"
                    app:tabIndicatorAnimationMode="elastic"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A000000" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAvatar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:text="Save My Avatar!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/agbalumo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorAccent"
            app:cornerRadius="36dp"
            app:elevation="12dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="@color/white"
            app:rippleColor="@color/white"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
