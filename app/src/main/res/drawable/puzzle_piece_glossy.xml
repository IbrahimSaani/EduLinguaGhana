<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow -->
    <item android:top="6dp" android:left="4dp">
        <shape>
            <solid android:color="#66000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Main Piece Body -->
    <item android:bottom="4dp" android:right="2dp">
        <shape>
            <gradient
                android:startColor="#FF4FC3F7"
                android:centerColor="#FF0288D1"
                android:endColor="#FF01579B"
                android:angle="270" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
        </shape>
    </item>

    <!-- Top Gloss Highlight -->
    <item android:bottom="40dp" android:left="10dp" android:right="10dp" android:top="6dp">
        <shape>
            <gradient
                android:startColor="#99FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Bottom Bevel -->
    <item android:top="60dp" android:left="12dp" android:right="12dp" android:bottom="8dp">
        <shape>
            <solid android:color="#22000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
