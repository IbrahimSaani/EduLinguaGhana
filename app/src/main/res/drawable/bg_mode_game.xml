<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Gradient Base -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FF311B92"
                android:centerColor="#FF1A237E"
                android:endColor="#FF0D47A1" />
        </shape>
    </item>

    <!-- Glowing Grid Overlay -->
    <item>
        <shape>
            <stroke
                android:width="0.5dp"
                android:color="#15FFFFFF"
                android:dashWidth="40dp"
                android:dashGap="40dp" />
        </shape>
    </item>

    <!-- Subtle Particle Textures -->
    <item>
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape>
                <stroke
                    android:width="0.3dp"
                    android:color="#08FFFFFF"
                    android:dashWidth="2dp"
                    android:dashGap="100dp" />
            </shape>
        </rotate>
    </item>
</layer-list>
