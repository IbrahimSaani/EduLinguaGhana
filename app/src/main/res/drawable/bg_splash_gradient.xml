<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base App Primary Color (Deep Indigo) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A237E" />
        </shape>
    </item>

    <!-- Sophisticated Highlight (Top Right) using a slightly lighter indigo/blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.8"
                android:centerY="0.2"
                android:startColor="#303F9F"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Secondary Accent Highlight (Bottom Left) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.2"
                android:centerY="0.8"
                android:startColor="#283593"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Subtle Golden/Accent Glow to match colorAccent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#00FFAB40"
                android:centerColor="#08FFAB40"
                android:endColor="#00FFAB40" />
        </shape>
    </item>
</layer-list>
