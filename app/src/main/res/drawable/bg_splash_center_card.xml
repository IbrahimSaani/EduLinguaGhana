<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Sophisticated semi-transparent dark-glass fill with a hint of indigo -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#25FFFFFF"
        android:centerColor="#103F51B5"
        android:endColor="#051A237E" />

    <corners android:radius="44dp" />

    <!-- Premium border to define edges - slightly translucent white/silver -->
    <stroke
        android:width="1.5dp"
        android:color="#35FFFFFF" />

    <padding
        android:left="36dp"
        android:top="36dp"
        android:right="36dp"
        android:bottom="36dp" />
</shape>
