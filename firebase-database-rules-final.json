{
  "rules": {
    "leaderboard": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".indexOn": ["score", "timestamp"],
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid && auth.token.email_verified === true && root.child('users').child(auth.uid).child('role').val() === 'STUDENT'",
        ".validate": "newData.hasChildren(['score', 'userName']) && newData.child('score').isNumber() && newData.child('userName').isString()"
      }
    },
    "users": {
      ".indexOn": ["email", "username", "role"],
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid && (auth.token.email_verified === true || !data.exists())",
        "fcmToken": {
          ".read": "$userId === auth.uid",
          ".write": "$userId === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isString()"
        },
        "role": {
          ".write": "$userId === auth.uid && auth.token.email_verified === true",
          ".validate": "newData.isString() && (newData.val() === 'STUDENT' || newData.val() === 'TEACHER' || newData.val() === 'PARENT')"
        },
        "displayName": {
          ".write": "$userId === auth.uid && auth.token.email_verified === true"
        },
        "badges": {
          ".write": "$userId === auth.uid && auth.token.email_verified === true"
        },
        "quests": {
          ".write": "$userId === auth.uid && auth.token.email_verified === true"
        },
        "achievements": {
          ".write": "$userId === auth.uid && auth.token.email_verified === true"
        },
        "progress": {
          ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
          ".write": "$userId === auth.uid"
        },
        "funGames": {
          ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
          ".write": "$userId === auth.uid"
        }
      }
    },
    "friends": {
      ".read": "auth != null && (query.orderByChild == 'userId' && query.equalTo == auth.uid || query.orderByChild == 'friendUserId' && query.equalTo == auth.uid)",
      ".indexOn": ["userId", "friendUserId", "status"],
      "$friendshipId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || data.child('friendUserId').val() === auth.uid)",
        ".write": "auth != null && auth.token.email_verified === true && ((!newData.exists() && (data.child('userId').val() === auth.uid || data.child('friendUserId').val() === auth.uid)) || (newData.exists() && (!data.exists() || data.child('userId').val() === auth.uid || data.child('friendUserId').val() === auth.uid) && (newData.child('userId').val() === auth.uid || newData.child('friendUserId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['userId', 'friendUserId', 'status'])"
      }
    },
    "challenges": {
      ".read": "auth != null",
      ".indexOn": ["state", "challengedId", "challengerId", "completedAt", "createdAt", "timestamp"],
      "$challengeId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || data.child('challengerId').val() === auth.uid || data.child('challengedId').val() === auth.uid || newData.child('challengerId').val() === auth.uid || newData.child('challengedId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['challengerId', 'challengedId', 'state']) && newData.child('state').isString() && (newData.child('state').val() === 'pending' || newData.child('state').val() === 'in_progress' || newData.child('state').val() === 'completed' || newData.child('state').val() === 'PENDING' || newData.child('state').val() === 'ONGOING' || newData.child('state').val() === 'COMPLETED' || newData.child('state').val() === 'EXPIRED' || newData.child('state').val() === 'CANCELLED' || newData.child('state').val() === 'accepted' || newData.child('state').val() === 'ACCEPTED') && newData.child('challengerId').isString() && newData.child('challengedId').isString() && newData.child('createdAt').isNumber() && newData.child('language').isString() && (newData.child('quizType').isString() || newData.child('quizMode').isString()) && (newData.child('durationMinutes').isNumber() || !newData.exists())",
        "challengerScore": {
          ".validate": "newData.isNumber() || !newData.exists()"
        },
        "challengedScore": {
          ".validate": "newData.isNumber() || !newData.exists()"
        },
        "winnerId": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "winner": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "hearts": {
          ".validate": "newData.isNumber() || !newData.exists()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() || !newData.exists()"
        }
      }
    },
    "challengeStats": {
      ".read": "auth != null",
      ".indexOn": ["userId", "winRate", "totalChallenges"],
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && $userId === auth.uid",
        ".validate": "newData.hasChildren(['userId', 'challengesWon', 'challengesLost', 'challengesTied', 'challengesDeclined', 'totalChallenges', 'winRate']) && newData.child('userId').val() === $userId && newData.child('challengesWon').isNumber() && newData.child('challengesLost').isNumber() && newData.child('challengesTied').isNumber() && newData.child('challengesDeclined').isNumber() && newData.child('totalChallenges').isNumber() && newData.child('winRate').isNumber()",
        "challengesWon": {
          ".validate": "newData.isNumber()"
        },
        "challengesLost": {
          ".validate": "newData.isNumber()"
        },
        "challengesTied": {
          ".validate": "newData.isNumber()"
        },
        "challengesDeclined": {
          ".validate": "newData.isNumber()"
        },
        "totalChallenges": {
          ".validate": "newData.isNumber()"
        },
        "winRate": {
          ".validate": "newData.isNumber()"
        },
        "lastChallengeTime": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "relationships": {
      ".read": "auth != null && (query.orderByChild == 'supervisorId' && query.equalTo == auth.uid || query.orderByChild == 'studentId' && query.equalTo == auth.uid)",
      ".indexOn": ["supervisorId", "studentId", "status"],
      "$relationshipId": {
        ".read": "auth != null && (data.child('supervisorId').val() === auth.uid || data.child('studentId').val() === auth.uid)",
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && (newData.child('supervisorId').val() === auth.uid || newData.child('studentId').val() === auth.uid)) || (data.exists() && (data.child('supervisorId').val() === auth.uid || data.child('studentId').val() === auth.uid || newData.child('supervisorId').val() === auth.uid || newData.child('studentId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['supervisorId', 'studentId', 'status', 'type', 'supervisorGender']) || !newData.exists()"
      }
    },
    "progress": {
      ".indexOn": ["userId"],
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
        ".write": "$userId === auth.uid",
        "activities": {
          ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
          ".write": "$userId === auth.uid",
          ".indexOn": ["timestamp"],
          "$activityId": {
            ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
            ".write": "$userId === auth.uid"
          }
        }
      }
    },
    "funGames": {
      ".indexOn": ["userId"],
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
        ".write": "$userId === auth.uid",
        ".validate": "newData.hasChildren(['userId','totalFunGames','bestScore']) || !newData.exists()"
      }
    },
    "aggregates": {
      ".indexOn": ["userId", "totalXP", "currentStreak"],
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
        ".write": "$userId === auth.uid && auth.token.email_verified === true"
      }
    },
    "achievement_shares": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email_verified === true",
      ".indexOn": ["userId", "timestamp"]
    },
    "milestones": {
      ".indexOn": ["userId"],
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
        ".write": "$userId === auth.uid && auth.token.email_verified === true",
        "$milestoneId": {
          ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
          ".write": "$userId === auth.uid && auth.token.email_verified === true"
        }
      }
    },
    "userStats": {
      ".indexOn": ["userId"],
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('relationships').child(auth.uid + '_' + $userId).child('status').val() === 'ACCEPTED')",
        ".write": "$userId === auth.uid && auth.token.email_verified === true"
      }
    },
    "app_config": {
      ".read": "auth != null",
      "word_of_the_day": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'TEACHER'"
      }
    },
    "announcements": {
      ".read": "auth != null",
      ".indexOn": ["teacherId", "timestamp", "type", "targetId"],
      "$announcementId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'TEACHER' && newData.child('teacherId').val() === auth.uid",
        ".validate": "newData.hasChildren(['message', 'timestamp', 'teacherId', 'type']) && (newData.child('type').val() === 'ALL' || newData.child('type').val() === 'CLASS' || newData.child('type').val() === 'STUDENT')"
      }
    }
  }
}
